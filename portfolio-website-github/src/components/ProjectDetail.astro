---
interface Fact {
  label: string;
  value: string;
}

interface Section {
  title: string;
  paragraphs?: string[];
  bullets?: string[];
  table?: {
    headers: string[];
    rows: string[][];
  };
  media?: {
    src: string;
    alt: string;
    caption?: string;
  };
}

interface Props {
  backHref: string;
  backLabel: string;
  eyebrow: string;
  title: string;
  lead: string;
  status: string;
  facts: Fact[];
  sections: Section[];
  nextLabel: string;
  nextHref: string;
  nextTitle: string;
}

const {
  backHref,
  backLabel,
  eyebrow,
  title,
  lead,
  status,
  facts,
  sections,
  nextLabel,
  nextHref,
  nextTitle,
} = Astro.props;
---

<main id="main-content">
  <article class="case-study container">
    <a class="back-link" href={backHref}><span aria-hidden="true">←</span> {backLabel}</a>

    <header class="case-study-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="case-study-lead">{lead}</p>
      <p class="status-pill">{status}</p>
    </header>

    <dl class="fact-grid">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>

    <div class="case-study-body">
      {sections.map((section) => (
        <section class="case-study-section">
          <h2>{section.title}</h2>
          <div>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="case-study-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.table && (
              <div class="case-study-table-wrap">
                <table class="case-study-table">
                  <thead>
                    <tr>
                      {section.table.headers.map((header) => <th scope="col">{header}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>
                        {row.map((cell) => <td>{cell}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.media && (
              <figure class="case-study-media">
                <img src={section.media.src} alt={section.media.alt} loading="lazy" />
                {section.media.caption && <figcaption>{section.media.caption}</figcaption>}
              </figure>
            )}
          </div>
        </section>
      ))}
    </div>

    <aside class="next-project">
      <p>{nextLabel}</p>
      <a href={nextHref}>{nextTitle}<span aria-hidden="true"> →</span></a>
    </aside>
  </article>
</main>
