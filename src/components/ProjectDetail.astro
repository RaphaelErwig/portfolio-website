---
interface Fact {
  label: string;
  value: string;
}

interface Media {
  src: string;
  alt: string;
  caption?: string;
  variant?: 'photo' | 'cad' | 'contain';
  width?: number;
  height?: number;
  /** When set, the media is rendered as a self-hosted video with `src` used as the poster image. */
  video?: string;
  videoLabel?: string;
}

interface Section {
  title: string;
  paragraphs?: string[];
  bullets?: string[];
  table?: {
    headers: string[];
    rows: string[][];
  };
  media?: Media[];
}

interface Limitations {
  title: string;
  intro?: string;
  items: string[];
}

interface Props {
  backHref: string;
  backLabel: string;
  eyebrow: string;
  title: string;
  lead: string;
  status: string;
  facts: Fact[];
  sections: Section[];
  heroMedia?: Media;
  limitations?: Limitations;
  nextLabel: string;
  nextHref: string;
  nextTitle: string;
}

const {
  backHref,
  backLabel,
  eyebrow,
  title,
  lead,
  status,
  facts,
  sections,
  heroMedia,
  limitations,
  nextLabel,
  nextHref,
  nextTitle,
} = Astro.props;
---

<main id="main-content">
  <article class="case-study container">
    <a class="back-link" href={backHref}><span aria-hidden="true">←</span> {backLabel}</a>

    <header class="case-study-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="case-study-lead">{lead}</p>
      <p class="status-pill">{status}</p>
    </header>

    {heroMedia && (
      <figure class:list={['case-study-cover', { 'case-study-cover-contain': heroMedia.variant === 'contain' }]}>
        {heroMedia.video ? (
          <video
            controls
            preload="none"
            playsinline
            poster={heroMedia.src}
            width={heroMedia.width}
            height={heroMedia.height}
            aria-label={heroMedia.videoLabel ?? heroMedia.alt}
          >
            <source src={heroMedia.video} type="video/mp4" />
          </video>
        ) : (
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            width={heroMedia.width}
            height={heroMedia.height}
            fetchpriority="high"
            decoding="async"
          />
        )}
        {heroMedia.caption && <figcaption>{heroMedia.caption}</figcaption>}
      </figure>
    )}

    <dl class="fact-grid">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>

    <div class="case-study-body">
      {sections.map((section) => (
        <section class="case-study-section">
          <h2>{section.title}</h2>
          <div>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="case-study-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            {section.table && (
              <div class="case-study-table-wrap">
                <table class="case-study-table">
                  <thead>
                    <tr>
                      {section.table.headers.map((header) => <th scope="col">{header}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, index) => (
                          <td data-label={section.table?.headers[index]}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.media?.map((media) => (
              <figure class:list={['case-study-media', { 'case-study-media-cad': media.variant === 'cad' || media.variant === 'contain' }]}>
                {media.video ? (
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster={media.src}
                    width={media.width}
                    height={media.height}
                    aria-label={media.videoLabel ?? media.alt}
                  >
                    <source src={media.video} type="video/mp4" />
                  </video>
                ) : (
                  <img
                    src={media.src}
                    alt={media.alt}
                    width={media.width}
                    height={media.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                {media.caption && <figcaption>{media.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>

    {limitations && (
      <aside class="limitations" aria-labelledby="limitations-title">
        <h2 id="limitations-title">{limitations.title}</h2>
        {limitations.intro && <p>{limitations.intro}</p>}
        <ul>
          {limitations.items.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    )}

    <aside class="next-project">
      <p>{nextLabel}</p>
      <a href={nextHref}>{nextTitle}<span aria-hidden="true"> →</span></a>
    </aside>
  </article>
</main>
