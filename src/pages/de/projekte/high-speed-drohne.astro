---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import Footer from '../../../components/Footer.astro';

const nav = {
  about: 'Über mich',
  projects: 'Projekte',
  experience: 'Erfahrung',
  skills: 'Fähigkeiten',
  contact: 'Kontakt',
  menu: 'Navigation öffnen',
  navigation: 'Hauptnavigation',
};

const facts = [
  { label: 'Aufwand', value: '≈ 200 Stunden' },
  { label: 'CAD', value: 'Onshape' },
  { label: 'Fertigung', value: 'PA-CF · Bambu Lab X1C' },
  { label: 'Aktueller Stand', value: 'Version 1 flugfähig · Version 2 im CAD' },
];

const sections = [
  {
    title: 'Ziel und Umfang',
    paragraphs: [
      'Entwicklungsziel war eine kompakte, leistungsorientierte Drohne mit einem langfristigen Geschwindigkeitsziel von 300 km/h – ohne Verwendung eines fertigen Rahmens. Die Zielgeschwindigkeit beschreibt die Entwicklungsrichtung und wurde noch nicht durch eine Messung validiert.',
      'Ich setzte das Projekt vollständig eigenständig um: Komponentenauswahl, mechanische Konstruktion, additive Fertigung, Löten, Montage, Betaflight-Konfiguration, PID-Abstimmung und Flugtests.',
    ],
  },
  {
    title: 'Mechanische und elektrische Auslegung',
    paragraphs: [
      'Tragender Rahmen, Verkleidung und Bauraum für die Komponenten entstanden über vier bis fünf größere Onshape-Iterationen. Die Konstruktion musste Steifigkeit, Aerodynamik, Kühlung, Bauraum, Reparierbarkeit, Fertigbarkeit und Kosten miteinander verbinden.',
    ],
    table: {
      headers: ['Subsystem', 'Auswahl in Version 1', 'Entscheidungsgrund'],
      rows: [
        ['Motoren', 'T-Motor Velox V2207 V3 · 2050 KV · 6S', 'Leistung bei kontrollierten Komponentenkosten'],
        ['Flugsteuerung', 'SpeedyBee F405 V5 · 55-A-Stack', 'Zuverlässigkeit bei einer zentralen Systemkomponente priorisiert'],
        ['Funkverbindung', 'RadioMaster RP3 V2 · ELRS', 'Robuste Verbindung mit kompaktem Empfänger'],
        ['Navigation', 'HGLRC M100 Pro GPS', 'Benötigte Ortung ohne Bezahlung ungenutzter Funktionen'],
        ['Antrieb', 'T-Motor T5143S · 5,1 Zoll · Dreiblatt', 'Auf den ausgewählten 6S-Antrieb abgestimmt'],
      ],
    },
  },
  {
    title: 'Flugtests und Lernprozess',
    paragraphs: [
      'Version 1 absolvierte einen Schwebetest und zwei kontrollierte Flüge. In einer frühen Testphase stürzte der Prototyp ab, als die PID-Abstimmung und meine eigene Flugerfahrung noch nicht ausreichten. Daraufhin trainierte ich im Simulator und baute zusätzlich eine einfacher zu fliegende Übungsdrohne.',
      'Die erste Version ist flugfähig. Höchstgeschwindigkeit, Flugzeit und finales Abfluggewicht wurden jedoch noch nicht unter definierten Bedingungen gemessen.',
    ],
  },
  {
    title: 'Erkenntnisse aus Version 1',
    paragraphs: [
      'Die praktischen Tests zeigten drei miteinander verknüpfte Schwächen. Resonanzen des Rahmens erschwerten die PID-Abstimmung; zugleich wurde die PA-CF-Struktur nach Feuchtigkeitsaufnahme mit der Zeit flexibler. Messungen mit einem Infrarotthermometer zeigten außerdem einen Wärmestau an Flight Controller und 4-in-1-ESC. Der oben montierte Akku verlagerte zudem zu viel Masse nach oben.',
    ],
    bullets: [
      'Vibrationen: neue Geometrie und Wechsel von PA-CF zu ABS-CF',
      'Kühlung: Lüftungsschlitze und neue Anordnung von Flight Controller und ESC',
      'Gewichtsverteilung: Akku tiefer, leichtere Komponenten höher',
      'Kontrolle: DJI O4 FPV vor den Leistungstests von Version 2',
    ],
  },
  {
    title: 'Entwicklungsprozess von Version 2',
    paragraphs: [
      'Version 2 befindet sich in der ersten CAD-Iteration. Als Nächstes wird ein kostengünstiger PLA-Prototyp gedruckt, um Bauraum, Montage und konstruktive Schwächen zu prüfen. Danach wird das CAD überarbeitet und erneut in PLA validiert, bevor die finale Version aus ABS-CF entsteht. Die gesamte Elektronik aus Version 1 soll weiterverwendet werden.',
      'ABS-CF wurde gewählt, weil die höhere Außenbeständigkeit des teureren ASA-CF für diesen Anwendungsfall nicht erforderlich ist. Gleichzeitig soll die Feuchtigkeitsempfindlichkeit von PA-CF vermieden werden, um eine berechenbarere Steifigkeit zu erhalten. Je nach genauer Materialsorte können Steifigkeit, Festigkeit und Wärmebeständigkeit jedoch unter trockenem PA-CF liegen. Deshalb müssen das ausgewählte Material und die neue Geometrie vor hohen Belastungen validiert werden.',
    ],
  },
  {
    title: 'Wirtschaftliche Entwicklung',
    paragraphs: [
      'Das Projekt wurde mit einem Budget von 700 € geplant. Die dokumentierten direkten Ausgaben liegen bei rund 424 €. Darin enthalten sind Fernsteuerung, etwa 1,4 kg Entwicklungsmaterial und 105 € für die bereits für Version 2 vorgesehene DJI-O4-Hardware. Ohne diese spätere FPV-Hardware liegen die dokumentierten Ausgaben bei rund 319 €. Eine anteilige Abschreibung des 3D-Druckers und nicht erfasste Kleinteile sind nicht enthalten.',
    ],
    table: {
      headers: ['Entscheidung', 'Wirtschaftlicher Gedanke', 'Technische Folge'],
      rows: [
        ['Motoren, GPS und Material', 'Ausreichende Leistung ohne Bezahlung ungenutzter Reserven', 'Erfüllen die aktuellen Prototypanforderungen; Grenzen am Geschwindigkeitsziel sind noch zu validieren'],
        ['Flight Controller und ESC', 'Höhere Ausgaben für zentrale, zuverlässigkeitskritische Elektronik', '55-A-Stack statt unbenannter günstigerer Alternative'],
        ['Eigener gedruckter Rahmen', 'Kein erhältlicher Rahmen entsprach der geplanten Geometrie', 'Schnelle Anpassungen und hoher Lernwert, aber 10–15 Entwicklungsdrucke'],
        ['PLA vor ABS-CF', 'Günstige Validierung vor dem finalen Material', 'Montage- und Konstruktionsfehler werden vor dem teuren Druck erkannt'],
        ['Wiederverwendung der Elektronik', 'Großer Teil der Investition bleibt erhalten', 'Version 2 erfordert vor allem mechanische Anpassungen und FPV'],
      ],
    },
  },
  {
    title: 'Aktuelles Ergebnis und Grenze',
    paragraphs: [
      'Version 1 belegt, dass das selbst konstruierte System fliegen kann, und liefert konkrete Anforderungen für die nächste Konstruktion. Sie belegt noch keinen sicheren Betrieb bei der angestrebten hohen Geschwindigkeit. Geschwindigkeit, Flugzeit und verifiziertes Abfluggewicht werden erst veröffentlicht, wenn Version 2 kontrollierte mechanische, thermische und fliegerische Tests bestanden hat.',
    ],
  },
];
---

<BaseLayout
  lang="de"
  title="Leistungsorientierter Drohnenprototyp | Raphael Erwig"
  description="Projektbericht zu eigener CAD-Konstruktion, additiver Fertigung, Flugtests und kostenbewusster Überarbeitung eines Drohnenprototyps."
  canonicalPath="/de/projekte/high-speed-drohne/"
  enPath="/projects/high-speed-drone/"
  dePath="/de/projekte/high-speed-drohne/"
>
  <Header
    lang="de"
    labels={nav}
    languageHrefs={{ en: '/projects/high-speed-drone/', de: '/de/projekte/high-speed-drohne/' }}
  />
  <ProjectDetail
    backHref="/de/#projects"
    backLabel="Zurück zu den Projekten"
    eyebrow="Hardware · CAD · Additive Fertigung"
    title="Iterative Entwicklung eines leistungsorientierten Drohnenprototyps"
    lead="Eine selbst konstruierte 6S-Drohne, bei der Flugtests, Materialverhalten, thermische Messungen und Kostenentscheidungen systematisch in Version 2 einfließen."
    status="Version 1 flugfähig · Geschwindigkeitsziel noch nicht validiert"
    {facts}
    {sections}
    nextLabel="Nächstes Projekt"
    nextHref="/de/projekte/messererkennung/"
    nextTitle="Live-Prototyp zur Messererkennung"
  />
  <Footer />
</BaseLayout>
