---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import Footer from '../../../components/Footer.astro';

const nav = {
  about: 'Über mich',
  projects: 'Projekte',
  experience: 'Erfahrung',
  skills: 'Fähigkeiten',
  contact: 'Kontakt',
  menu: 'Navigation öffnen',
  navigation: 'Hauptnavigation',
  cv: 'Lebenslauf',
};

/** TODO Raphael: auf true setzen, sobald /media/drone-flight-demo.mp4 existiert. */
const showFlightVideo = false;

const facts = [
  { label: 'Zeitraum', value: '2026 · Revision 1 abgeschlossen, Revision 2 in CAD' },
  { label: 'Konstruktionsiterationen', value: '4–5 größere Onshape-Revisionen' },
  { label: 'Fertigung', value: 'PA-CF · Bambu Lab X1C' },
  { label: 'Dokumentierte Ausgaben', value: '≈ 424 € bei 700 € Budget' },
];

const sections = [
  {
    title: 'Ziel und Rahmen',
    paragraphs: [
      'Ziel war eine kompakte, leistungsorientierte Drohne ohne fertigen Rahmen von der Stange. Revision 1 war auf einen 6S-Antriebsstrang mit einer Zielgeschwindigkeit von rund 170 km/h ausgelegt – hergeleitet aus der Pitch Speed dieser Motor-Propeller-Kombination, abzüglich eines realistischen Abschlags für Schlupf und Luftwiderstand. Der Wert war ein Auslegungsziel, nie ein Messergebnis, und Revision 2 wechselt die Leistungsklasse vollständig, sodass er nicht übertragbar ist.',
      'Ich habe das Projekt in rund 200 Stunden eigenständig umgesetzt: Komponentenauswahl, mechanische Konstruktion, additive Fertigung, Löten, Aufbau, Betaflight-Konfiguration, PID-Abstimmung und Flugtests.',
    ],
  },
  {
    title: 'Mechanische und elektrische Konstruktion',
    paragraphs: [
      'Tragender Rahmen, Verkleidung und die Anordnung der Komponenten entstanden in vier bis fünf größeren Onshape-Iterationen. Die Geometrie musste Steifigkeit, Aerodynamik, Kühlung, Bauraum, Reparierbarkeit, Druckbarkeit und Kosten gegeneinander abwägen.',
    ],
    media: [
      {
        src: '/images/drone-top-dark.webp',
        alt: 'Draufsicht der flugfähigen ersten Drohnenrevision mit Vier-Motoren-Anordnung und gedrucktem Mittelteil',
        caption: 'Revision 1 · symmetrische Motoranordnung und gedrucktes Mittelteil',
        width: 1400,
        height: 1050,
      },
      {
        src: '/images/drone-cad-revision-1.webp',
        alt: 'Onshape-CAD-Modell der ersten Drohnenrevision mit sichtbarem zentralem Komponentenfach',
        caption: 'Revision 1 · CAD-Modell des selbst konstruierten Rahmens mit Komponentenanordnung',
        variant: 'cad',
        width: 1400,
        height: 1025,
      },
    ],
    table: {
      headers: ['Baugruppe', 'Wahl in Revision 1', 'Konstruktive Begründung'],
      rows: [
        ['Motoren', 'T-Motor Velox V2207 V3 · 2050 KV · 6S', 'Leistung bei kontrollierten Komponentenkosten'],
        ['Flugsteuerung', 'SpeedyBee F405 V5 · 55-A-Stack', 'Zuverlässigkeit bei einer zentralen Systemkomponente priorisiert'],
        ['Funkstrecke', 'RadioMaster RP3 V2 · ELRS', 'Robuste Verbindung mit kompaktem Empfänger'],
        ['Navigation', 'HGLRC M100 Pro GPS', 'Benötigte Positionsbestimmung ohne Bezahlung ungenutzter Funktionen'],
        ['Antrieb', 'T-Motor T5143S · 5,1 Zoll · dreiblättrig', 'Auf den gewählten 6S-Antriebsstrang abgestimmt'],
      ],
    },
  },
  {
    title: 'Flugtests und Erkenntnisse',
    paragraphs: [
      'Revision 1 absolvierte einen Schwebetest und zwei kontrollierte Flüge. Früh in der Testphase stürzte der Prototyp ab, als PID-Abstimmung und meine eigene Flugerfahrung noch nicht ausreichten. Ich habe daraufhin im Simulator geübt und eine zweite, leichter zu fliegende Trainingsdrohne aufgebaut, bevor ich weitergemacht habe – günstiger, als den Prototyp wiederholt zu reparieren.',
    ],
  },
  ...(showFlightVideo
    ? [
        {
          title: 'Flugaufnahmen',
          paragraphs: ['Ungeschnittene Aufnahmen aus den Flugtests der Revision 1.'],
          media: [
            {
              src: '/images/drone-hero-dark.webp',
              video: '/media/drone-flight-demo.mp4',
              alt: 'Ungeschnittene Aufnahme der ersten Drohnenrevision während eines kontrollierten Flugtests',
              videoLabel: 'Ungeschnittene Aufnahme der ersten Drohnenrevision während eines kontrollierten Flugtests',
              caption: 'Revision 1 · ungeschnittene Flugtestaufnahme',
              width: 1400,
              height: 787,
            },
          ],
        },
      ]
    : []),
  {
    title: 'Erkenntnisse aus Revision 1',
    paragraphs: [
      'Die praktischen Tests zeigten drei zusammenhängende Schwachstellen. Rahmenresonanzen erschwerten die PID-Abstimmung, und die PA-CF-Struktur wurde mit zunehmender Feuchtigkeitsaufnahme nachgiebiger. Infrarotmessungen zeigten außerdem einen Wärmestau um Flugcontroller und 4-in-1-ESC. Schließlich brachte der oben montierte Akku zu viel Masse in die obere Struktur.',
      'Jede Erkenntnis führt direkt zu einer Änderung in Revision 2:',
    ],
    bullets: [
      'Vibration: überarbeitete Geometrie und Wechsel von PA-CF zu ABS-CF',
      'Kühlung: Lüftungsschlitze und neue Anordnung von Flugcontroller und ESC',
      'Gewichtsverteilung: Akku tiefer positioniert, leichtere Komponenten nach oben',
      'Steuerung: DJI O4 FPV vor allen Leistungstests ergänzt',
    ],
    media: [
      {
        src: '/images/drone-detail-dark.webp',
        alt: 'Detailansicht der ersten Drohnenrevision mit gedruckter Verkleidung, Armgeometrie und Antriebsanordnung',
        caption: 'Revision 1 im Detail · gedruckte Verkleidung, Armgeometrie und Antriebsanordnung',
        width: 1400,
        height: 1400,
      },
    ],
  },
  {
    title: 'Revision 2 · eine andere Maschine, keine geflickte',
    paragraphs: [
      'Revision 2 befindet sich in der ersten CAD-Iteration. Die Erkenntnisse aus Revision 1 zeigten auf die Struktur und das Antriebssystem, nicht auf Details der Geometrie. Der zweite Aufbau ist deshalb keine reparierte Fassung des ersten: Rahmen, Motoren, ESC, Flugcontroller und Propeller werden alle ersetzt. Übernommen werden nur das GPS-Modul und der ELRS-Empfänger.',
      'Das neue Antriebssystem ist für 8S und 12S statt 6S ausgelegt, und eine DJI O4 Lite kommt hinzu, damit Revision 2 vor jedem Leistungstest ordentlich geflogen und beurteilt werden kann. Weil der Antriebsstrang die Klasse wechselt, ist das Geschwindigkeitsziel aus Revision 1 hinfällig – ein neuer Wert wird erst veröffentlicht, wenn die Motor-Propeller-Kombination feststeht und die Rechnung neu gemacht wurde.',
      'Die Aufbaureihenfolge bleibt: ein günstiger PLA-Druck, um Schwachstellen in Anordnung, Montage und Struktur zu finden, dann eine überarbeitete Geometrie erneut in PLA, dann der finale ABS-CF-Aufbau. ABS-CF wurde gewählt, weil der Vorteil des teureren ASA-CF bei der Außenbeständigkeit hier nicht benötigt wird, während das Vermeiden der Feuchtigkeitsempfindlichkeit von PA-CF entscheidend ist, um die Steifigkeit über die Zeit vorhersagbar zu halten.',
    ],
    bullets: [
      'Ersetzt: Rahmen und Material, Motoren, ESC, Flugcontroller, Propeller',
      'Übernommen: GPS-Modul und ELRS-Empfänger',
      'Neu: DJI O4 Lite FPV',
      'Leistungsklasse: 8S/12S-fähig statt 6S',
    ],
  },
  {
    title: 'Wirtschaftliche Betrachtung',
    paragraphs: [
      'Revision 1 war gegen ein Budget von 700 € geplant und kam auf rund 424 € dokumentierte direkte Ausgaben, einschließlich Fernsteuerung, etwa 1,4 kg Entwicklungsmaterial und 105 € DJI-O4-FPV-Hardware. Ohne diese FPV-Hardware kostete Revision 1 rund 319 €.',
      'Fast das gesamte System in Revision 2 zu ersetzen ist die teure Entscheidung in diesem Projekt, und sie war bewusst. Revision 1 war günstig genug, um sie als Lernplattform zu behandeln: Sie hat beantwortet, wie Struktur, Kühlung und Massenverteilung aussehen müssen – und diese Antworten wiesen über das hinaus, was ein 6S-System und ein geflickter Rahmen leisten können. Die alten Komponenten mitzunehmen hätte rund 300 € Hardware erhalten und das Ergebnis gedeckelt.',
    ],
    table: {
      headers: ['Entscheidung', 'Wirtschaftliche Begründung', 'Technische Konsequenz'],
      rows: [
        ['Motoren, GPS und Material', 'Ausgewählt für ausreichende Leistung, ohne ungenutzte Reserven zu bezahlen', 'Erfüllen die aktuellen Prototypanforderungen'],
        ['Flugcontroller und ESC', 'Höhere Ausgabe für die zentrale, zuverlässigkeitskritische Elektronik', '55-A-Stack statt No-Name-Alternative gewählt'],
        ['Eigener gedruckter Rahmen', 'Kein verfügbarer Rahmen passte zur angestrebten Geometrie', 'Schnelle Konstruktionsänderungen, dafür 10–15 Entwicklungsdrucke'],
        ['PLA vor ABS-CF', 'Günstige Validierung vor dem finalen Material', 'Montage- und Strukturschwächen vor dem teuren Druck korrigiert'],
        ['Neuer Antriebsstrang statt Weiterverwendung', 'Nimmt die Abschreibung der Revision-1-Elektronik in Kauf, statt Revision 2 zu deckeln', 'Wechsel von 6S auf ein 8S/12S-fähiges System; nur GPS und Empfänger werden übernommen'],
      ],
    },
  },
  {
    title: 'Ergebnis',
    paragraphs: [
      'Revision 1 ist abgeschlossen: Sie belegt, dass das selbst konstruierte System fliegt, und lieferte konkrete, gemessene Konstruktionshinweise für den nächsten Aufbau. Der bisherige Wert des Projekts liegt in dieser Beweiskette – aus drei Flügen wurde eine konkrete, begründete Spezifikation für Revision 2 statt einer Neukonstruktion nach Bauchgefühl, einschließlich der Entscheidung, die Leistungsklasse zu wechseln statt zu flicken.',
    ],
  },
];

const limitations = {
  title: 'Offene Punkte und Grenzen',
  intro:
    'Revision 1 ist ein Prototyp, und einiges wird bewusst noch nicht behauptet. Das sind die offenen Punkte, bevor Leistungswerte veröffentlicht werden.',
  items: [
    'Geschwindigkeit: Die rund 170 km/h waren ein Auslegungsziel für den Antriebsstrang von Revision 1 und wurden nie simulativ oder messtechnisch bestätigt. Für Revision 2 gilt der Wert nicht; das Ziel wird neu berechnet, sobald die neue Motor-Propeller-Kombination feststeht. Für keine der beiden Revisionen wird eine Höchstgeschwindigkeit behauptet.',
    'Flugdaten: Flugzeit und verifizierte Abflugmasse wurden nicht unter definierten Bedingungen gemessen.',
    'Komponentenauswahl: Motoren, ESC, Flugcontroller und Propeller für Revision 2 sind gewählt, hier aber noch nicht veröffentlicht, und keines der Teile wurde bisher im Aufbau getestet.',
    'Material: ABS-CF kann je nach genauer Sorte geringere Steifigkeit, Festigkeit und Wärmebeständigkeit aufweisen als trockenes PA-CF. Material und überarbeitete Geometrie müssen daher vor Tests unter hoher Last validiert werden.',
    'Kosten: Abschreibung des Druckers und nicht erfasste Kleinverbrauchsmaterialien sind in den 424 € nicht enthalten, und das Komponentenbudget für Revision 2 steht noch nicht fest.',
    'Sicherheit: Revision 1 belegt keinen sicheren Betrieb bei der angestrebten Geschwindigkeit. Gemessene Geschwindigkeit, Flugzeit und Abflugmasse werden erst veröffentlicht, wenn Revision 2 kontrollierte mechanische, thermische und flugtechnische Tests bestanden hat.',
  ],
};
---

<BaseLayout
  lang="de"
  title="Leistungsorientierter Drohnenprototyp | Raphael Erwig"
  description="Fallstudie: eigene CAD-Konstruktion, additive Fertigung, Flugtests und kostenbewusste Revision eines selbst entwickelten Drohnenprototyps."
  canonicalPath="/de/projekte/high-speed-drohne/"
  enPath="/projects/high-speed-drone/"
  dePath="/de/projekte/high-speed-drohne/"
  socialImage="/social-preview-drone-de.png"
>
  <Header
    lang="de"
    labels={nav}
    languageHrefs={{ en: '/projects/high-speed-drone/', de: '/de/projekte/high-speed-drohne/' }}
  />
  <ProjectDetail
    backHref="/de/#projects"
    backLabel="Zurück zu den Projekten"
    eyebrow="Hardware · CAD · Additive Fertigung"
    title="Iterative Entwicklung eines leistungsorientierten Drohnenprototyps"
    lead="Eine selbst konstruierte 6S-Drohne, die praktische Flugtests, Materialverhalten, Wärmemessungen und Kostenabwägungen in eine strukturierte zweite Revision überführt."
    status="Revision 1 abgeschlossen · Revision 2 in CAD"
    heroMedia={{
      src: '/images/drone-hero-dark.webp',
      alt: 'Dreiviertelansicht des selbst entwickelten flugfähigen Drohnenprototyps vor dunklem Hintergrund',
      caption: 'Revision 1 · selbst konstruierte PA-CF-Struktur',
      width: 1400,
      height: 787,
    }}
    {facts}
    {sections}
    {limitations}
    nextLabel="Nächste Fallstudie"
    nextHref="/de/projekte/messererkennung/"
    nextTitle="Live-Prototyp zur Messererkennung"
  />
  <Footer lang="de" />
</BaseLayout>
