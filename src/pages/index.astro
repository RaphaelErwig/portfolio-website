---

<BaseLayout
  lang="en"
  title="Raphael Erwig | Engineering & Product Development"
  description="Portfolio of Raphael Erwig: hardware development, computer vision, product engineering and commercially grounded technical decisions."
  canonicalPath="/"
  enPath="/"
  dePath="/de/"
>
  <Header lang="en" labels={content.nav} />
  <HomeContent {projects} {strengths} {skillGroups} {experience} {content} />
  <Footer />
</BaseLayout>
